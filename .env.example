NODE_ENV=development # One of test, development, production

DB_HOST=localhost
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=deployforgedb
DATABASE_URL=postgres://myuser:mypassword@localhost:5432/deployforgedb
REDIS_URL=redis://localhost:6379

# GitHub personal access token for repository metadata requests
GITHUB_TOKEN=

ACCESS_TOKEN_SECRET=#openssl rand --base64 32
REFRESH_TOKEN_SECRET=#openssl rand --base64 32

API_KEY_SECRET= #openssl rand --base64 32